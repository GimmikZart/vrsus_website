# VRSUS environment: development | quality | production
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:3000

# Public Supabase values. DEV values are available after `supabase start`.
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NUXT_PUBLIC_SUPABASE_KEY=<supabase-anon-key>

# Server-only secret. Never expose this value to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>

# Reserved for future adapters; keep empty until the integration is implemented.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
RESEND_API_KEY=
