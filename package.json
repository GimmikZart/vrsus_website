{
  "name": "vrsus-web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:prepare": "nuxt prepare",
    "db:start": "supabase start",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:types": "supabase gen types typescript --local --schema public > app/types/database.types.ts",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"app/**/*.{vue,ts,css}\" \"server/**/*.ts\" \"shared/**/*.{ts,vue}\" \"tests/**/*.ts\" package.json nuxt.config.ts eslint.config.mjs prettier.config.mjs playwright.config.ts tsconfig.json vitest.config.ts README.md --write",
    "format:check": "prettier \"app/**/*.{vue,ts,css}\" \"server/**/*.ts\" \"shared/**/*.{ts,vue}\" \"tests/**/*.ts\" package.json nuxt.config.ts eslint.config.mjs prettier.config.mjs playwright.config.ts tsconfig.json vitest.config.ts README.md --check",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.30",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.11.0",
    "@nuxtjs/supabase": "^2.0.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "@zxing/browser": "^0.1.5",
    "gsap": "^3.13.0",
    "nuxt": "^4.5.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.11.0",
    "@nuxt/test-utils": "^3.19.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.9.1",
    "happy-dom": "^20.0.10",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.11"
  }
}
